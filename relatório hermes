import sqlite3
import hashlib
import os

conn = sqlite3.connect(':memory:')
cursor = conn.cursor()

cursor.execute("""
    CREATE TABLE usuarios (
        id INTEGER PRIMARY KEY,
        usuario TEXT UNIQUE,
        salt TEXT,
        senha_hash TEXT
    )
""")

def gerar_hash_senha(senha: str, salt: bytes = None):
    if salt is None:
        salt = os.urandom(16)
    chave = hashlib.pbkdf2_hmac('sha256', senha.encode('utf-8'), salt, 100000)
    return salt.hex(), chave.hex()

def cadastrar_usuario(usuario, senha):
    salt_hex, hash_hex = gerar_hash_senha(senha)
    cursor.execute(
        "INSERT INTO usuarios (usuario, salt, senha_hash) VALUES (?, ?, ?)",
        (usuario, salt_hex, hash_hex)
    )

cadastrar_usuario('admin', 'SenhaSuperSecreta123')
cadastrar_usuario('user1', 'MinhaSenha456')
conn.commit()

print("--- TELA DE LOGIN (CORRIGIDA) ---")
username_input = input("Usuário: ")
password_input = input("Senha: ")

cursor.execute(
    "SELECT salt, senha_hash FROM usuarios WHERE usuario = ?",
    (username_input,)
)
registro = cursor.fetchone()

if registro:
    salt_banco = bytes.fromhex(registro[0])
    hash_esperado = registro[1]
    _, hash_tentativa = gerar_hash_senha(password_input, salt_banco)

    if hash_tentativa == hash_esperado:
        print("Login bem-sucedido!")
    else:
        print("Falha no login: Credenciais invalidas.")
else:
    print("Falha no login: Credenciais invalidas.")

conn.close()
